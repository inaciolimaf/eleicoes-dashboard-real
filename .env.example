# Copie para .env (o `make up` faz isso automaticamente na primeira vez).

# ---- Fonte de dados do TSE ---------------------------------------------------
# fake     -> mock local (serviço tse-fake), para testar sem depender do TSE
# simulado -> ambiente de simulado do TSE (só fica no ar em janelas definidas pelo TSE)
# oficial  -> divulgação oficial (dia da eleição)
TSE_AMBIENTE=fake
TSE_BASE_URL=http://tse-fake:8080/oficial
# TSE real:
#   TSE_AMBIENTE=oficial
#   TSE_BASE_URL=https://resultados.tse.jus.br/oficial
#   TSE_MAX_RPS=60          (o TSE bloqueia o IP por 10 min acima de 100 req/s)
#   LOCAIS_VOTACAO_URL=<URL do CSV/ZIP "Eleitorado - local de votação 2026" no Portal de Dados Abertos>
TSE_MAX_RPS=400
TSE_CONCORRENCIA=32
TSE_VERIFICAR_JWS=true
COLETAR_SECOES=true
COLETAR_ZONAS=true
INTERVALO_CATALOGO=30
INTERVALO_PRINCIPAL=5
INTERVALO_ACOMPANHAMENTO=5
INTERVALO_MIN_MUNICIPIO=20
LOCAIS_VOTACAO_URL=http://tse-fake:8080/dadosabertos/eleitorado_local_votacao_2026.csv
TSE_FAKE_CONTROLE_URL=http://tse-fake:8080/_fake

# ---- Mock do TSE (tse-fake) --------------------------------------------------
# Velocidade do relógio simulado (5 = a noite de ~6h passa em ~1h12min). Pode mudar ao vivo na página Admin.
FAKE_VELOCIDADE=5
# Minutos em relação às 17h em que o relógio começa (-2 = 16:58)
FAKE_INICIO_MIN=-2
FAKE_SEMENTE=2026
# Escala do número de seções (1.0 ≈ 57 mil seções)
FAKE_ESCALA=1.0

# ---- Aplicação ---------------------------------------------------------------
JWT_SECRET=troque-este-segredo-por-um-valor-longo-e-aleatorio
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
WORKER_CONCORRENCIA=6
LOG_LEVEL=INFO
